{
  "compilerOptions": {
    "target": "ES2022", "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true, "esModuleInterop": true,
    "types": ["node", "react", "react-dom"]
  },
  "include": ["../public-page/*.tsx", "../app/public-pages.tsx", "../app/public-site.tsx", "../lib/content.ts", "../lib/public-content.ts", "../lib/limits.ts"]
}
